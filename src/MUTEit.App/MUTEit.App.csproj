<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One EXE, two main modes:
      MUTEit.exe (no argument)   : tray (Windows Forms NotifyIcon, microphone control, hotkey hook, overlay, taskbar switch).
                                   Avalonia is never loaded in this mode.
      MUTEit.exe with "settings" : settings window (Avalonia), separate process, ends when the window closes.
      (see Program.cs for all arguments)
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>MUTEit.App</RootNamespace>
    <AssemblyName>MUTEit</AssemblyName>
    <AssemblyTitle>MUTEit</AssemblyTitle>
    <Description>MUTEit – microphone mute control for the Windows system tray</Description>
    <ApplicationIcon>Assets\muteit.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWindowsForms>true</UseWindowsForms>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- Low idle memory for the always-running tray -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!--
    Release builds are self-contained (no .NET runtime needed on the target PC) so the normal build folder
    bin\Release\net10.0-windows10.0.19041.0\win-x64\ is directly the input of the installer.
    RuntimeIdentifiers (plural) is set for every configuration so NuGet restore always contains win-x64.
  -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- Windows Forms and Avalonia share type names (Application, Button, Color …): no implicit WinForms usings. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <!-- Tray / overlay / taskbar images and sounds: embedded resources (read by Windows Forms and the sound output) -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\muteit.ico" LogicalName="MUTEit.Assets.muteit.ico" />
    <EmbeddedResource Include="Assets\logo-mask.png" LogicalName="MUTEit.Assets.logo-mask.png" />
    <EmbeddedResource Include="Assets\glyph-mask.png" LogicalName="MUTEit.Assets.glyph-mask.png" />
    <EmbeddedResource Include="Assets\menu\*.png" LogicalName="MUTEit.Assets.menu.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\overlay\*.png" LogicalName="MUTEit.Assets.overlay.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\sounds\*.wav" LogicalName="MUTEit.Assets.sounds.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Settings window assets (Avalonia) -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\logo-mask.png" />
    <AvaloniaResource Include="Assets\app-256.png" />
    <AvaloniaResource Include="Assets\muteit.ico" />
    <AvaloniaResource Include="Assets\flag-*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MUTEit.Core\MUTEit.Core.csproj" />
    <ProjectReference Include="..\MUTEit.Platform.Windows\MUTEit.Platform.Windows.csproj" />
  </ItemGroup>

  <!-- Shipped next to the app: licenses (About page) and README -->
  <ItemGroup>
    <None Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Installer: after every Release build, build\build.ps1 (Windows PowerShell 5.1, present on every Windows) packs the
    self-contained build folder with Inno Setup → artifacts\muteit_v<version>_setup.exe (+ .sha256).
    A failing Inno Setup run fails the build (error MUT…); a missing Inno Setup installation is only a warning.
    Switched off with /p:MuteitSkipInstaller=true (build.ps1 itself, CI) and while publishing.
  -->
  <Target Name="MuteitInstaller" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT' and '$(MuteitSkipInstaller)' != 'true' and '$(_IsPublishing)' != 'true'">
    <PropertyGroup>
      <MuteitBuildScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\build\build.ps1'))</MuteitBuildScript>
      <MuteitSourceDir>$([System.IO.Path]::GetFullPath('$(TargetDir)').TrimEnd('\'))</MuteitSourceDir>
    </PropertyGroup>
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MuteitBuildScript)&quot; -InstallerOnly -SourceDir &quot;$(MuteitSourceDir)&quot;" />
  </Target>

</Project>
