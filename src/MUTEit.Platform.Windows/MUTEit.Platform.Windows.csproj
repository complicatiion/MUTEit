<Project Sdk="Microsoft.NET.Sdk">

  <!-- Win32 / COM layer: Core Audio (microphones, output devices), low-level input hooks, taskbar (ITaskbarList3, AppUserModelID, jump list), foreground tracking, autostart, theme / accent. No packages. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MUTEit.Platform.Windows</RootNamespace>
    <AssemblyName>MUTEit.Platform.Windows</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MUTEit.Core\MUTEit.Core.csproj" />
  </ItemGroup>

</Project>
